<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>TrayLink.ico</ApplicationIcon>
    <PackageIcon>TrayLink.png</PackageIcon>
    <Product>TrayLink</Product>
    <Company>ReHoGa Interactive</Company>
    <PackageReleaseNotes>1.6.0</PackageReleaseNotes>
    <AssemblyVersion>1.6.0</AssemblyVersion>
    <FileVersion>1.6.0</FileVersion>
    <InformationalVersion>1.6.0</InformationalVersion>
    <BuildUpdater>true</BuildUpdater>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <SourceRevisionId></SourceRevisionId>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- ===================== -->
  <!--   Updater on BUILD    -->
  <!-- ===================== -->
  <Target Name="PublishAndCopyUpdater_OnBuild" BeforeTargets="Build" Condition="'$(BuildUpdater)' == 'true'">
    <PropertyGroup>
      <_UpdaterBuildPublishDir>$(OutDir)updater_pub</_UpdaterBuildPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish ..\Updater\Updater.csproj -c $(Configuration) -r win-x64 --self-contained false /p:PublishSingleFile=true /p:PublishTrimmed=false -o &quot;$(_UpdaterBuildPublishDir)&quot;" />
    <Copy SourceFiles="$(_UpdaterBuildPublishDir)\Updater.exe" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- ===================== -->
  <!--   Updater on PUBLISH  -->
  <!-- ===================== -->
  <Target Name="PublishAndCopyUpdater_OnPublish" BeforeTargets="Publish" Condition="'$(BuildUpdater)' == 'true'">
    <PropertyGroup>
      <_UpdaterPublishDir>$(PublishDir)updater_pub</_UpdaterPublishDir>
    </PropertyGroup>
    <Exec Command="dotnet publish ..\Updater\Updater.csproj -c $(Configuration) -r win-x64 --self-contained false /p:PublishSingleFile=true /p:PublishTrimmed=false -o &quot;$(_UpdaterPublishDir)&quot;" />
    <Copy SourceFiles="$(_UpdaterPublishDir)\Updater.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Remove="Resources\TrayLink.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TrayLink.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\TrayLink.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Resources\TrayLink.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSec.Cryptography" Version="25.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
